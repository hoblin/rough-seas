#!/usr/bin/env python3
"""Draw the hull damage overlays: bin/damage [PREVIEW.png]

Writes RoughSeas/assets/roughseas/textures/entity/vessel/damage/<material>-<stage>.png, 32x32 like the
textures they lie on. Stage 1 is the first after sound; each stage keeps the marks of the one before
and adds its own. Seeded, so a run redraws the same marks. With PREVIEW, also writes every overlay
laid over its base texture, eight times larger, one material a row.
"""
import random
import struct
import subprocess
import sys
import zlib
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
OUT = ROOT / "RoughSeas/assets/roughseas/textures/entity/vessel/damage"
SIZE = 32
STAGES = 4

PALE_WOOD = (214, 182, 130)
SPLIT = (38, 24, 14)
INNER_BARK = (176, 112, 62)
BARK_EDGE = (70, 44, 26)
REED_FIBRE = (170, 152, 92)
REED_GAP = (44, 40, 20)
HIDE_SCUFF = (196, 170, 128)
HOLE = (20, 14, 10)
HOLE_RIM = (120, 92, 60)


class Canvas:
    def __init__(self):
        self.pixels = [[(0, 0, 0, 0)] * SIZE for _ in range(SIZE)]

    def put(self, x, y, colour, alpha):
        if 0 <= x < SIZE and 0 <= y < SIZE and alpha > self.pixels[y][x][3]:
            self.pixels[y][x] = (*colour, alpha)

    def line(self, x0, y0, x1, y1, colour, alpha):
        steps = max(abs(x1 - x0), abs(y1 - y0), 1)
        for i in range(steps + 1):
            self.put(round(x0 + (x1 - x0) * i / steps), round(y0 + (y1 - y0) * i / steps), colour, alpha)

    def png(self, path):
        raw = b"".join(b"\0" + bytes(c for p in row for c in p) for row in self.pixels)
        chunk = lambda kind, data: struct.pack(">I", len(data)) + kind + data + struct.pack(">I", zlib.crc32(kind + data))
        path.write_bytes(b"\x89PNG\r\n\x1a\n" + chunk(b"IHDR", struct.pack(">IIBBBBB", SIZE, SIZE, 8, 6, 0, 0, 0))
                         + chunk(b"IDAT", zlib.compress(raw, 9)) + chunk(b"IEND", b""))


def scratches(canvas, rand, count, colour):
    for _ in range(count):
        x, y = rand.randrange(SIZE), rand.randrange(SIZE)
        length = rand.randint(3, 6)
        dx, dy = rand.choice([(1, 1), (1, -1), (1, 0), (2, 1), (1, 2)])
        canvas.line(x, y, x + dx * length // 2, y + dy * length // 2, colour, 190)


def splits(canvas, rand, count, shortest, longest, edge):
    for _ in range(count):
        x, y, length = rand.randrange(SIZE), rand.randrange(SIZE), rand.randint(shortest, longest)
        for i in range(length):
            drift = y + (1 if rand.random() < 0.15 else 0)
            canvas.put(x + i, drift, SPLIT, 235)
            if edge:
                canvas.put(x + i, drift + 1, PALE_WOOD, 170)


def tears(canvas, rand, count, size, inner, edge):
    for _ in range(count):
        cx, cy = rand.randrange(SIZE), rand.randrange(SIZE)
        w, h = rand.randint(size, size * 2), rand.randint(max(1, size // 2), size)
        for y in range(cy, cy + h):
            for x in range(cx - w // 2, cx + w // 2 + 1):
                if rand.random() < 0.85:
                    canvas.put(x, y, inner, 230)
        canvas.line(cx - w // 2, cy - 1, cx + w // 2, cy - 1, edge, 240)
        canvas.line(cx - w // 2 - 1, cy + h, cx + w // 2 - 1, cy + h, edge, 200)


def holes(canvas, rand, count, radius):
    for _ in range(count):
        cx, cy = rand.randrange(SIZE), rand.randrange(SIZE)
        for y in range(cy - radius - 1, cy + radius + 2):
            for x in range(cx - radius - 1, cx + radius + 2):
                d = ((x - cx) ** 2 + (y - cy) ** 2) ** 0.5
                if d <= radius:
                    canvas.put(x, y, HOLE, 250)
                elif d <= radius + 1:
                    canvas.put(x, y, HOLE_RIM, 200)


def frays(canvas, rand, count, length):
    for _ in range(count):
        x, y = rand.randrange(SIZE), rand.randrange(SIZE)
        for i in range(length):
            canvas.put(x + i, y - i // 3, REED_FIBRE, 210)


def gaps(canvas, rand, count, shortest, longest):
    for _ in range(count):
        x, y, length = rand.randrange(SIZE), rand.randrange(SIZE), rand.randint(shortest, longest)
        canvas.line(x, y, x + length, y, REED_GAP, 235)
        canvas.line(x + 1, y + 1, x + length - 2, y + 1, REED_GAP, 160)


def wood(canvas, rand, stage):
    if stage == 1:
        scratches(canvas, rand, 6, PALE_WOOD)
    elif stage == 2:
        splits(canvas, rand, 3, 5, 9, False)
    elif stage == 3:
        splits(canvas, rand, 5, 9, 16, True)
    elif stage == 4:
        splits(canvas, rand, 6, 16, 30, True)


def bark(canvas, rand, stage):
    if stage == 1:
        scratches(canvas, rand, 6, INNER_BARK)
    elif stage == 2:
        tears(canvas, rand, 3, 2, INNER_BARK, BARK_EDGE)
    elif stage == 3:
        tears(canvas, rand, 3, 4, INNER_BARK, BARK_EDGE)
    else:
        tears(canvas, rand, 2, 4, INNER_BARK, BARK_EDGE)
        holes(canvas, rand, 2, 2)


def reed(canvas, rand, stage):
    if stage == 1:
        frays(canvas, rand, 6, 4)
    elif stage == 2:
        frays(canvas, rand, 6, 6)
        gaps(canvas, rand, 2, 4, 7)
    elif stage == 3:
        gaps(canvas, rand, 4, 7, 14)
    else:
        gaps(canvas, rand, 5, 14, 28)
        frays(canvas, rand, 6, 8)


def hide(canvas, rand, stage):
    if stage == 1:
        scratches(canvas, rand, 7, HIDE_SCUFF)
    elif stage == 2:
        scratches(canvas, rand, 6, HIDE_SCUFF)
        holes(canvas, rand, 2, 0)
    elif stage == 3:
        holes(canvas, rand, 3, 1)
    else:
        holes(canvas, rand, 3, 2)
        tears(canvas, rand, 1, 3, HOLE, HOLE_RIM)


MATERIALS = {
    "wood": (wood, "game:block/wood/debarked/oak"),
    "bark": (bark, "game:block/wood/bark/birch-h"),
    "reed": (reed, "roughseas:entity/vessel/reed"),
    "hide": (hide, "game:block/leather/poor"),
}


def texture(code):
    domain, path = code.split(":")
    if domain == "roughseas":
        return ROOT / "RoughSeas/assets/roughseas/textures" / f"{path}.png"
    import os
    return Path(os.environ["VINTAGE_STORY"]) / "assets/survival/textures" / f"{path}.png"


def main():
    OUT.mkdir(parents=True, exist_ok=True)
    for material, (draw, _) in MATERIALS.items():
        canvas, rand = Canvas(), random.Random(material)
        for stage in range(1, STAGES + 1):
            draw(canvas, rand, stage)
            canvas.png(OUT / f"{material}-{stage}.png")
    if len(sys.argv) > 1:
        rows = []
        for material, (_, base) in MATERIALS.items():
            tiles = [str(texture(base))]
            for stage in range(1, STAGES + 1):
                tiles += ["(", str(texture(base)), str(OUT / f"{material}-{stage}.png"), "-composite", ")"]
            rows += ["(", *tiles, "+append", ")"]
        subprocess.run(["magick", *rows, "-append", "-filter", "point", "-resize", "800%", sys.argv[1]], check=True)
        print(sys.argv[1])


main()
