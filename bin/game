#!/usr/bin/env bash
set -euo pipefail

usage() {
  echo "Rough Seas test bench: run the mod in Vintage Story 1.22.7 and drive it from the shell."
  if [ -n "${BENCH:-}" ]; then clone; else
    echo
    echo "THIS CLONE: mise did not load $root/mise.toml, so the bench cannot run; see its error above."
  fi
  guide
}

clone() {
  cat <<EOF

THIS CLONE ($root)
  Bench name $BENCH: tmux sessions $BENCH-client and $BENCH-server
  Game data  $BENCH_DATA (dedicated server: .../server)
  Logs       Logs/client-main.log and server/Logs/server-main.log in the game data. When loading
             an entity throws, AgentBridge logs which one first: grep "Entity failed to load".
  Ports      agent bridge $BENCH_BRIDGE_PORT, dedicated server $BENCH_SERVER_PORT
  Each clone of the repository runs its own bench. Name, data folder and temp folder follow the
  clone's directory name; the ports do not, so every clone but one needs its own, set in its
  gitignored mise.local.toml (bin/client and bin/server refuse a taken port and say so):
    [env]
    BENCH_BRIDGE_PORT = "42426"
    BENCH_SERVER_PORT = "42421"
  A clone's first bin/client seeds the account login into its data folder from
  ~/.config/VintagestoryData/clientsettings.json (only read, never written).
EOF
}

guide() {
  cat <<'EOF'

START
  bin/client [WORLD]   build both mods, (re)start this clone's client in tmux, muted, and return
                       once the world is loaded and the server answers (~35 s). A running world
                       is saved and left first, as Save & Quit does: vessels, ropes, the
                       player's place and /worldconfig changes are there after the restart.
                       Opens singleplayer world WORLD (default "sea"); a new world is made with the
                       AgentBridge preset: creative, standard worldgen, 70% ocean.
                       An existing world is reopened without the preset: re-applying it crashes
                       the client on some worlds (#24).
                       Every start turns temporal storms, stability and rifts off, and unridden
                       vessels hold still until /bridge drift on.
                       BENCH_MODS picks the mods loaded (default "roughseas agentbridge"):
                       BENCH_MODS=agentbridge, or BENCH_MODS= for vanilla, to tell our crash from
                       the game's. Without agentbridge, bin/game cannot drive it; read the log.
  bin/client server    connect the client to this clone's dedicated server instead (multiplayer).
                       The player needs admin there, once per server data folder:
                       tmux send-keys -t <bench>-server '/op <your player name>' Enter
  bin/server           build both mods, (re)start this clone's dedicated server in tmux (saved and
                       stopped first) and return once it runs; its console takes commands the
                       same way
  bin/client qa        connect the client, with this clone's build, to the machine's QA server
                       (bin/qa help) to try a scene there. The same login as the player's: not
                       while they play.
  bin/ref              fetch Anego's sources and decompile the engine into ref/ (gitignored)
  bin/model            edit, preview and check shapes in Blender, headless; bin/model help
  bin/game wait [S]    block until the world is loaded and the server answers, closing the
                       character-creation dialog; fails after S seconds (default 180).
                       bin/client already does it.
  The rules no tool carries are in docs/bench.md; read them with this help.
  The client runs unfocused and needs no input from the desktop; never send it real keys.
  It picks what lies under the crosshair, as a focused one does, and bin/client hands the desktop
  focus back to the window that had it once the game's window opens.

LOOK
  bin/game state             player pos, camera, swimming, flying, vitals (health, oxygen, bodyTemp,
                             wetness), hotbar, mount, what the camera points at, entities within
                             16 blocks (a shape's rendered roll and pitch in degrees: how a vessel
                             rocks), open dialogs, paused, pickingRange. Pointing at an entity, `reach` is
                             what a swing is measured by: the picked selection box, the eye's
                             distance to the entity's default box (vanilla's measure) and to
                             the point hit (a vessel's), and the held item's range
  bin/game here              server side, at the player: its height, sea level, oceanity (0 land, 255 sea),
                             fluid at feet and head, seabed height, season, temperature, rainfall,
                             wind vector, precipitation, wind/weather pattern, weather event
  bin/game entity ID         server side: code, alive, pos, behaviours, all watched attributes
  (log)                      storms log every event to the server's debug log, tagged [storms]:
                             breakers with their energy, water shipped, anchors down, dragged and
                             lost, ropes snapped, lightning, the ashore roll when a moored vessel
                             loads. Read it before guessing:
                             grep -a '\[storms\]' "$BENCH_DATA/Logs/server-debug.log"
  bin/game fps [SECONDS]     frames rendered over SECONDS (default 5): fps, mean and 95th-percentile
                             frame time in ms. Compare a change against BENCH_MODS=agentbridge from
                             the same place and camera.
  bin/game shot [FILE] [gui] in-engine screenshot of the world alone: no HUD, hand or held item
                             (default shot.png; a relative FILE lands in the clone's temp folder,
                             /tmp/<bench>); prints the path of a half-size copy, cheaper to look at.
                             With gui, the HUD and open dialogs stay in the picture
  bin/game hotkey CODE       cyclecamera for third person; bin/game hotkey alone lists every code
  To look at anything, fly: `bin/scene look ID` from any side, `/bridge fly` anywhere. To only
  look, '/gamemode spectator' draws no player at all, but spectators pick nothing.

ACT
  bin/game do CMD...         run commands as the player, in order, printing each reply:
                             /server commands and .client commands. A reply that says
                             "Hovering at X Y Z" (/bridge fly, sea, storm) waits for `arrive`,
                             then for the server to load the chunks around the player, by
                             its debug log ("[bridge] flight N: chunks loaded ... after S s")
  bin/game arrive X Y Z [S]  block until the client stands within a block of X Y Z (as commands take
                             them); fails after S seconds (default 30). Use it after a /tp.
  bin/game look YAW PITCH    aim the camera, radians. Yaw 0 faces +Z, pi/2 +X, pi -Z;
                             pitch pi is level, above pi looks down (range 1.59-4.70)
  bin/game aim ID            aim the camera at an entity
  bin/game hover [ID [BOX]]  make the game treat entity ID as looked at, whatever the camera points
                             at: the HUD shows its name and info text, interactions target it, and
                             the reply is that name and text as JSON. Without ID, stop.
                             BOX aims at one selection box by its attachment point, e.g. the
                             sailboat's LProwAP (anchor) or LowerMastAP, as an accessory needs;
                             a wrong BOX lists the entity's boxes.
                             Use it instead of aiming by coordinates at small selection boxes.
                             The HUD part needs creative or survival: spectators do not pick.
  bin/game hover X Y Z       the same for the top face of the block at absolute X Y Z (as `state`
                             prints them), water included: a held raft or block is placed on it.
  bin/game slot N            select hotbar slot N (0-9)
  bin/game press KEYS [MS]   hold keys for MS ms (default 100). GlKeys names, comma-separated:
                             W,A,S,D, Space, ShiftLeft, ControlLeft, Q, E, R, F, Number1 ...
                             Mounted, W/S row or sail and A/D steer.
  bin/game click [BUTTON] [MS]  hold left, right (default) or middle on what the camera points at
  bin/game scroll [STEPS]    turn the mouse wheel STEPS notches (default 1) over the open dialogs,
                             down; negative scrolls up. A long handbook page shows its end this way
  bin/game close             close open dialogs
  bin/game link HREF         follow a link as a click in the game's text does: handbook://PAGECODE
                             opens a handbook page (handbook://tab-guide a tab), handbooksearch://TEXT
                             searches it. A wrong protocol lists the known ones
  bin/game recipe OUTPUT [FROM]
                             on the open handbook page, hold the crafting grid that makes OUTPUT
                             (roughseas:dugout-oak) still on that recipe, out of FROM when given
                             (game:rope from roughseas:anchorwarp), scroll it into view and print
                             its box on screen, "=" and output included, as JSON x y width height
                             in the pixels of `shot`. Fails while no grid on the page makes it:
                             the handbook still building, or the wrong page

SERVER COMMANDS (via bin/game do; /help bridge lists them)
  /bridge sea                fly to the nearest open sea, hovering just above the surface
  /bridge shore              fly to the nearest flat, dry ground beside the sea, hovering just above
                             it. Far out at sea no shore is loaded: it flies toward the coast and
                             says to run it again once the land has loaded
  /bridge await [TYPE] [WARMTH] [PRESENCE] [HOURS]
                             bring a storm to the player instead of flying to it: move time on
                             until a storm of the model covers the player where they stand, at
                             PRESENCE (default 0.7) or more, within HOURS (default a year). TYPE is
                             squall, gale, hurricane or any; WARMTH warm (from 12 °C, thunder),
                             cold (below 0 °C, snow) or any. No flight and no new chunks: the way
                             to test a storm
  /bridge storm [RANGE] [WAVES]
                             fly to where the storms within RANGE blocks (default 60000) raise the
                             highest waves over open sea, or those nearest WAVES metres, hovering
                             just above the surface; replies with the wave height. Set the time of
                             day first: storms move. A far flight generates new chunks for a minute:
                             `/bridge await` brings a storm without one.
  /bridge force FORCE [RANGE]
                             find the roughest of the nearest open seas where the wind blows at
                             Beaufort FORCE (a grid within 5000 blocks, storms within RANGE, default
                             30000) and fly there; seated, it replies with the
                             /tp that takes the vessel along, since the rider's client steers it
  /bridge approach [DISTANCE] [TYPE]
                             fly over open sea DISTANCE blocks (default 500) outside the rim of the
                             strongest storm within 60000, of TYPE (squall, gale, hurricane) when
                             given; replies with the yaw for `look` that faces its centre. '/time
                             stop' first holds the storm where it is while you look.
  /bridge find CODE [RANGE]  fly over the nearest block at the surface whose code matches CODE
                             (wildcards: tallplant-*), within RANGE blocks (default 256, at most 512)
  /bridge drift [on|off]     whether unridden vessels drift with the current and the wind. Off on
                             every start, so a vessel stays where it was put; a drift test turns it on
  /bridge ride CODE          spawn a boat at the player (on the surface over water) and seat the
                             player in its steering seat: boat-raft-oak, boat-sailed-oak, any wood.
                             Until a flight has landed it refuses: "Still flying there"
  /bridge mount ID [SEAT]    seat the player in an existing seatable entity: a steering seat first,
                             or the seat of index SEAT (0 is the first in its entity's seats)
  /bridge wear CODE          put item CODE in the first empty backpack slot, worn on the back
  /bridge hold CODE          put item or block CODE in the active hotbar slot, held in the hand
  /bridge drop CODE X Y Z    an item or block CODE lying on the ground there, at rest (~ relative)
  /bridge set ID KEY VALUE   set a watched attribute: int, float, bool or string by its form, while a
                             double or float stays what it is; e.g. the sailboat's sailPosition 0, 1, 2;
                             TREE/KEY reaches into a tree: roughseas:vessel/integrity 0.6 for a hull,
                             roughseas:bilge/litres 200 for the water aboard
  /bridge fly X Y Z          hover there in creative free flight, out of any seat: no sinking.
                             X Y Z as /tp takes them (~ relative). Then `aim ID` or `look`
                             frames the shot, e.g. /bridge fly ~6 ~4 ~ and bin/game aim 4300.
  /bridge dismount         get out of the seat, leaving the vessel where it is (a /tp while seated
                             takes the vessel along)
  /bridge tie ID X Y Z      tie entity ID to the block at absolute X Y Z with a vanilla rope, as a
                             player would (a vessel to a fence post: its stake)
  /bridge ropes ID           where each rope tied to entity ID is pinned: a block, an entity, or loose
  /bridge strike ID JOULES   strike a vessel's hull as an impact of that energy would; replies with
                             its integrity (watched "roughseas:vessel"), 0 breaks it into wreckage
  /bridge interact ID attack|interact [none|ctrl|shift] [BOX]
                             (BOX: the selection box clicked, by its attachment point, e.g.
                             CargoAP to put a held basket there with ctrl; by default the click lands
                             on the entity itself, no box)
                             what the server does when the player left- or right-clicks entity
                             ID with the held item, wherever the player stands, with ctrl or shift
                             held; replies with its integrity if it is a vessel. The client sends
                             no click, so use it where `click` cannot reach the entity. With
                             shift, a vessel that can be carried is picked up, as Shift + click does
  /bridge blast ID RADIUS [DISTANCE]
                             an explosion that injures entities within RADIUS and breaks no blocks,
                             DISTANCE blocks east of entity ID (default 0) and one above it
  /bridge here, /bridge entity ID   what `here` and `entity` call

RECIPES
  A vessel at sea, seen from three sides, kept over a restart:
    bin/client; bin/scene dock roughseas:dugout-oak     (prints the vessel's id)
    bin/scene look ID 4 1 0; bin/game shot east.png; bin/scene look ID 0 1 -5; bin/game shot north.png
    bin/scene look ID 0 6 0.01; bin/game shot above.png
    bin/client; bin/game state                          (the vessel is still in `nearby`)
  Calm noon at sea on a raft, oar in hand:
    bin/game do '/time set 12:00' '/weather setprecip 0' '/weather set clearsky' \
      '/weather setw still' '/giveitem oar-crude-oak 1' '/bridge sea' '/bridge ride boat-raft-oak'
    bin/game press W 4000
  Sailing: '/bridge ride boat-sailed-oak', then '/bridge set <boat id> sailPosition 2'
    (the boat id is in `state`.mountedOn). Full sail moves ~7 blocks/s with no input.
  Storm: '/weather setw storm' '/weather set cumulonimbus' '/weather setev heavythunder';
    '/debug lntest spawn' strikes lightning 10 blocks ahead. '/weather acp false' stops
    patterns changing.
    `/weather setw` acts on the player's region; wind readers blend four regions, so `here`
    shows less than the pattern's strength.
  Obstacles: '/giveblock rock-granite 64', `slot` to it, then
    '/we mark ~-2 ~-3 ~-8 ~2 ~3 ~-6' '/we fill' '/we clear'; '/we delete' removes a marked area.
    /help we lists WorldEdit, including /we import of schematics.
  Creatures: '/entity spawnat fish-saltwater-bream-sea-adult 1 ~2 ~ ~ 0',
    '/entity remove e[type=fish-saltwater-bream-sea-adult]'. Codes: /entity list.
  Diving, cold: '/gamemode survival' and watch `state`.vitals (oxygen drains 1000/s);
    '/time speed 600' (default 60) or '/time add 3 hours' to fast-forward.
    An idle swimmer sinks to the seabed.

GOTCHAS
  Coordinates in commands are relative to the map centre (512000), as the game shows them;
    `state` and `entity` print absolute ones. Use ~ for relative to the player.
  After a teleport, ~ commands use the client's stale position until it catches up: `do` waits for
    the bridge's own flights; after a /tp, `arrive` first.
  A camera change shows in `state`.lookingAt on the next frame; wait ~0.5 s.
  A new player gets a character-creation dialog that pauses the game: `wait` closes it.
  New worlds get a random seed, so do not hard-code sea coordinates: use /bridge sea.
  `bin/scene clear` removes entities only; blocks you placed and /worldconfig changes stay.
  Never `pkill -f "bin/game ..."`: the pattern matches, and kills, your own shell. Every wait has a
    timeout instead.
  The bridge listens on 127.0.0.1 only ("localhost" may resolve to ::1 and miss it), and
    refuses requests without the X-Agent-Bridge header, so web pages cannot drive it.
EOF
}

if [[ ${1:-help} == help ]]; then
  source "$(dirname "$0")/lib/bench.sh" || true
  usage
  exit
fi
source "$(dirname "$0")/lib/bench.sh"
bridge=http://127.0.0.1:$BENCH_BRIDGE_PORT
centre=512000

get() { curl -sf -m "${request_limit:-600}" -H 'X-Agent-Bridge: 1' "$@"; }
post() { get -X POST --data-binary "${2:-}" "$bridge$1"; }
fail() { echo "$1" >&2; exit 1; }

arrive() {
  local x=$1 y=$2 z=$3 deadline=$((SECONDS + ${4:-30})) request_limit=10
  until get "$bridge/state" | jq -e --argjson c "$centre" --argjson x "$x" --argjson y "$y" --argjson z "$z" \
    '[.pos.X - $c - $x, .pos.Y - $y, .pos.Z - $c - $z] | all(fabs < 1)' >/dev/null; do
    [ $SECONDS -lt $deadline ] || fail "The client never arrived at $x $y $z; bin/game state shows where it is"
    sleep 0.5
  done
}

settle() {
  local flight=$1 deadline=$((SECONDS + ${2:-180})) log=$BENCH_DATA/Logs/server-debug.log line
  [ "$BENCH_DATA/server/Logs/server-debug.log" -nt "$log" ] && log=$BENCH_DATA/server/Logs/server-debug.log
  until line=$(grep -a "\[bridge\] flight $flight: chunks" "$log"); do
    [ $SECONDS -lt $deadline ] || fail "The server's chunks around flight $flight never settled; read $log"
    sleep 1
  done
  [[ $line != *"still loading"* ]] || fail "${line##*\[bridge\] }; read $log"
  echo "${line##*\[bridge\] }"
}

case "${1:-}" in
  wait)
    deadline=$((SECONDS + ${2:-180})) request_limit=10
    until get "$bridge/state" >/dev/null 2>&1; do
      [ $SECONDS -lt $deadline ] || fail "No world within ${2:-180} s; read $BENCH_DATA/Logs/client-main.log"
      sleep 1
    done
    until post /close-dialogs >/dev/null && post /chat '/bridge drift' | grep -q .; do
      [ $SECONDS -lt $deadline ] || fail "The server did not answer within ${2:-180} s; read $BENCH_DATA/Logs/server-main.log"
      sleep 1
    done
    get "$bridge/state"
    ;;
  state) get "$bridge/state" ;;
  do)
    shift
    for line in "$@"; do
      reply=$(post /chat "$line")
      echo "$reply"
      x=
      read -r x y z < <(sed -n 's/.*Hovering at \(-\?[0-9.]*\) \(-\?[0-9.]*\) \(-\?[0-9.]*\).*/\1 \2 \3/p' <<<"$reply") || true
      [ -z "$x" ] || arrive "$x" "$y" "$z"
      flight=$(sed -n 's/.*(flight \([0-9]*\)).*/\1/p' <<<"$reply")
      [ -z "$flight" ] || settle "$flight"
    done
    ;;
  arrive) arrive "$2" "$3" "$4" "${5:-30}" ;;
  here) post /chat "/bridge here" ;;
  entity) post /chat "/bridge entity $2" ;;
  shot)
    file=${2:-shot.png}
    [[ $file == /* ]] || file=$BENCH_TMP/$file
    mkdir -p "$(dirname "$file")"
    get -o "$file" "$bridge/screenshot${3:+?gui=1}"
    magick "$file" -resize 50% "${file%.png}-small.png"
    echo "${file%.png}-small.png"
    ;;
  fps) post "/fps?seconds=${2:-5}" ;;
  look) post "/look?yaw=$2&pitch=$3" ;;
  aim) post "/look?entity=$2" ;;
  hover)
    if [ $# -ge 4 ]; then post "/hover?block=$2,$3,$4"; else post "/hover?entity=${2:-}&box=${3:-}"; fi
    ;;
  slot) post "/look?slot=$2" ;;
  press) post "/input?keys=$2&ms=${3:-100}" ;;
  click) post "/input?mouse=${2:-right}&ms=${3:-100}" ;;
  hotkey) post "/hotkey?code=${2:-}" ;;
  scroll) post "/scroll?steps=${2:-1}" ;;
  close) post /close-dialogs ;;
  link) post "/link?href=$(jq -rn --arg href "$2" '$href | @uri')" ;;
  recipe) post "/recipe?output=$(jq -rn --arg output "$2" '$output | @uri')&from=$(jq -rn --arg from "${3:-}" '$from | @uri')" ;;
  leave) post /leave ;;
  *) usage ;;
esac
