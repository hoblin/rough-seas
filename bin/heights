#!/usr/bin/env -S uv run --quiet --script
# /// script
# requires-python = ">=3.10"
# dependencies = ["numpy>=1.26"]
# ///
"""Read the drawn water's height off a take in height colours: bin/heights VIDEO LOWEST HIGHEST

  bin/heights VIDEO LOWEST HIGHEST [--region X0 Y0 X1 Y1] [--top N]
                       VIDEO filmed with `.surface colours true LOWEST HIGHEST`, the range in metres
                       above still water. Each pixel of the region (fractions of the frame, default
                       the whole of it) whose colour is a height colour is turned back into its
                       height. Prints the take's frames with the largest jumps between one frame and
                       the next: the mean height change where both frames hold water, and the share
                       of the region that turned to water or left it.
  bin/heights help     this text.

A height colour is fully saturated and bright; sand, grass and the block outlines are not, and
count as no water.
"""
import argparse
import subprocess
import sys

import numpy as np

WIDTH = 320
PURPLE_HUE = 0.78


def frames(video, width):
    probe = subprocess.run(["ffprobe", "-v", "error", "-select_streams", "v:0", "-show_entries", "stream=width,height,r_frame_rate",
                            "-of", "csv=p=0", video], capture_output=True, text=True, check=True).stdout.strip().split(",")
    w, h = int(probe[0]), int(probe[1])
    num, den = map(float, probe[2].split("/"))
    height = round(h * width / w / 2) * 2
    stream = subprocess.Popen(["ffmpeg", "-v", "error", "-i", video, "-vf", f"scale={width}:{height}", "-f", "rawvideo", "-pix_fmt", "rgb24", "-"],
                              stdout=subprocess.PIPE)
    size = width * height * 3
    index = 0
    while chunk := stream.stdout.read(size):
        if len(chunk) < size:
            break
        yield index * den / num, np.frombuffer(chunk, np.uint8).reshape(height, width, 3).astype(np.float32) / 255
        index += 1


def heights(rgb, lowest, highest):
    top = rgb.max(axis=2)
    bottom = rgb.min(axis=2)
    span = top - bottom
    water = (top > 0.45) & (span > 0.8 * top)
    r, g, b = rgb[..., 0], rgb[..., 1], rgb[..., 2]
    safe = np.where(span > 0, span, 1)
    hue = np.where(top == r, ((g - b) / safe) % 6, np.where(top == g, (b - r) / safe + 2, (r - g) / safe + 4)) / 6
    hue = np.where(hue > (1 + PURPLE_HUE) / 2, hue - 1, hue)
    share = np.clip(1 - hue / PURPLE_HUE, 0, 1)
    return np.where(water, lowest + share * (highest - lowest), np.nan)


def main():
    if len(sys.argv) < 2 or sys.argv[1] in ("help", "-h", "--help"):
        print(__doc__)
        return
    parser = argparse.ArgumentParser(prog="bin/heights", add_help=False)
    parser.add_argument("video")
    parser.add_argument("lowest", type=float)
    parser.add_argument("highest", type=float)
    parser.add_argument("--region", type=float, nargs=4, default=[0, 0, 1, 1])
    parser.add_argument("--top", type=int, default=10)
    args = parser.parse_args()
    x0, y0, x1, y1 = args.region
    rows, last, last_time = [], None, None
    for time, rgb in frames(args.video, WIDTH):
        h, w = rgb.shape[:2]
        now = heights(rgb[int(y0 * h):int(y1 * h), int(x0 * w):int(x1 * w)], args.lowest, args.highest)
        if last is not None:
            both = ~np.isnan(now) & ~np.isnan(last)
            moved = float(np.nanmean(np.abs(now - last)[both])) if both.any() else 0.0
            came = float((~np.isnan(now) & np.isnan(last)).mean())
            went = float((np.isnan(now) & ~np.isnan(last)).mean())
            rows.append((time, moved, came, went))
        last, last_time = now, time
    if not rows:
        sys.exit("No frames read")
    moves = np.array([row[1] for row in rows])
    turns = np.array([row[2] + row[3] for row in rows])
    print(f"{len(rows)} steps; height change per frame: median {np.median(moves):.3f} m, p99 {np.percentile(moves, 99):.3f} m; "
          f"region turning wet or dry per frame: median {np.median(turns):.1%}, p99 {np.percentile(turns, 99):.1%}")
    print("time s   height m   turned wet   turned dry")
    for time, moved, came, went in sorted(rows, key=lambda row: max(row[1] / max(np.percentile(moves, 99), 1e-6), (row[2] + row[3]) / max(np.percentile(turns, 99), 1e-6)), reverse=True)[:args.top]:
        print(f"{time:7.3f}  {moved:8.3f}   {came:10.1%}   {went:10.1%}")


if __name__ == "__main__":
    main()
