#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'EOF'
bin/scene dock [CODE...]   calm noon at open sea, the player in creative flying just above the surface;
                           each CODE (default boat-raft-oak boat-sailed-oak) is spawned unmanned
                           beside it, 4 blocks apart, and holds still. Prints the spawned entity ids.
                           A CODE without a domain is the game's; ours carry theirs: roughseas:dugout-oak.
bin/scene look ID [DX DY DZ]
                           the one way to look at anything: fly to entity ID's position plus DX DY DZ
                           (default 3 1 0: east of it and a block up), hover there and aim at it.
                           A shot from any side, over land or sea; 0 6 0.01 looks straight down,
                           above the water's tint. `bin/game hotkey togglehud` hides the HUD.
bin/scene photo ID FILE [DX DY DZ] [hover]
                           a wiki-ready image (16:9 .webp, 960 wide) of entity ID from where `look`
                           puts the camera, without the HUD; with `hover`, the panel the game shows
                           for what the crosshair is on (name, hull, bilge) is laid over its top.
bin/scene storm [RANGE [WAVES]] [CODE...]
                           noon, then the highest storm waves over open sea within RANGE blocks
                           (default 60000), or those nearest WAVES metres:
                           the player hovering 12 blocks above the surface, each CODE
                           (default boat-sailed-oak boat-raft-oak) riding below, 6 blocks apart, in one
                           sea state. Dangerous oceans on: the waves board, swamp, capsize and break them.
                           /worldconfig dangerousOceans false keeps them whole.
bin/scene clear [RANGE] [TYPE...]
                           remove entities of each TYPE (default every vessel and item; wildcards allowed,
                           e.g. drifter-*) within RANGE blocks (default 64) of the player. Blocks,
                           ropes tied to blocks and /worldconfig changes stay.
bin/scene views CODE DIR [SCALE]
                           every form a vessel takes, as wiki-ready images in DIR: afloat from the
                           side, the bow and stern quarters and above; beside the vanilla sailboat;
                           ashore from the side and a quarter; dropped on the ground; held in the
                           hand; worn on the back (a vessel with a backpack slot); the wreckage it
                           leaves (16:9 .webp, 960 wide), and its hotbar slot (icon.png). SCALE
                           (default 1) moves the camera out for a bigger vessel.
                           It changes the world as it goes: clears vessels and items around the
                           player, breaks the vessel, flies to the nearest shore and deletes the
                           plants (and anything else) in a 13x6x13 box there, and empties the
                           player's inventory.
Run them after bin/client.
EOF
}

game="$(dirname "$0")/game"

dock() {
  local codes=("$@")
  [ ${#codes[@]} -eq 0 ] && codes=(boat-raft-oak boat-sailed-oak)
  "$game" do '/gamemode creative' '/time set 12:00' '/weather setprecip 0' '/weather set clearsky' \
    '/weather setw still' '/weather acp false' >/dev/null
  local sea
  sea=$("$game" do '/bridge sea')
  [[ $sea == *Hovering* ]] || { echo "$sea" >&2; exit 1; }
  local x=-4
  for code in "${codes[@]}"; do
    "$game" do "/entity spawnat $code 1 ~$x ~-2 ~-5 0" >/dev/null
    x=$((x + 4))
  done
  sleep 3
  "$game" state | jq -c --argjson codes "$(printf '%s\n' "${codes[@]}" | jq -R . | jq -s 'map(if contains(":") then . else "game:" + . end)')" \
    '{player: .pos, vessels: [.nearby[] | select(.code as $c | $codes | index($c)) | {EntityId, code}]}'
}

look() {
  local id=$1 dx=${2:-3} dy=${3:-1} dz=${4:-0} entity at
  entity=$("$game" entity "$id")
  [[ $entity == {* ]] || { echo "$entity" >&2; exit 1; }
  at=$(jq -r --argjson dx "$dx" --argjson dy "$dy" --argjson dz "$dz" <<<"$entity" \
    '.pos | "\(.X - 512000 + $dx) \(.Y + $dy) \(.Z - 512000 + $dz)"')
  "$game" do "/bridge fly $at" >/dev/null
  "$game" aim "$id" >/dev/null
}

photo() {
  local id=$1 out=$2 hover=${6:-}
  look "$id" "${3:-3}" "${4:-1}" "${5:-0}"
  sleep 2
  local clean=$BENCH_TMP/photo.png gui=$BENCH_TMP/photo-gui.png width height
  "$game" shot "$clean" >/dev/null
  read -r width height <<<"$(identify -format '%w %h' "$clean")"
  local layers=("$clean" -gravity center -crop "${width}x$((width * 9 / 16))+0+0" +repage)
  if [ "$hover" = hover ]; then
    "$game" hover "$id" >/dev/null
    sleep 1
    "$game" shot "$gui" gui >/dev/null
    "$game" hover >/dev/null
    local quarter=$((width / 4)) w h x y
    IFS='x+' read -r w h x y <<<"$(magick "$gui" -crop "$((quarter * 2))x$((height / 8))+${quarter}+0" +repage \
      -colorspace HSL -channel G -separate +channel -threshold 15% -negate \
      -morphology Close Square:3 -morphology Open Square:6 \
      -define connected-components:verbose=true -define connected-components:area-threshold=2000 \
      -connected-components 8 null: |
      awk -v mid="$quarter" 'NR > 1 && $NF == "gray(255)" { split($2, b, /[x+]/); if (b[3] <= mid && b[3] + b[1] >= mid) { print $2; exit } }')"
    magick "$gui" -crop "${w}x${h}+$((x + quarter))+${y}" +repage "$BENCH_TMP/panel.png"
    layers+=("$BENCH_TMP/panel.png" -gravity north -geometry +0+12 -composite)
  fi
  magick "${layers[@]}" -resize 960x -quality 82 "$out"
}

storm() {
  local numbers=()
  while [[ ${1:-} =~ ^[0-9.]+$ ]]; do numbers+=("$1"); shift; done
  local codes=("$@")
  [ ${#codes[@]} -eq 0 ] && codes=(boat-sailed-oak boat-raft-oak)
  "$game" do '/gamemode creative' '/time set 12:00' '/worldconfig dangerousOceans true' >/dev/null
  local storm
  storm=$("$game" do "/bridge storm ${numbers[*]}")
  echo "$storm"
  [[ $storm == *Hovering* ]] || exit 1
  "$game" do '/bridge fly ~ ~11 ~' >/dev/null
  local x=$(( -3 * (${#codes[@]} - 1) ))
  for code in "${codes[@]}"; do
    "$game" do "/entity spawnat $code 1 ~$x 109 ~-8 0" >/dev/null
    x=$((x + 6))
  done
  "$game" do '/seas here'
}

clear() {
  local range=${1:-64}
  shift || true
  local types=("$@")
  [ ${#types[@]} -eq 0 ] && types=(boat-* roughseas:reedboat roughseas:dugout-* roughseas:coracle roughseas:barkcanoe roughseas:currach roughseas:outrigger-* item)
  for type in "${types[@]}"; do
    "$game" do "/entity remove e[type=$type,range=$range]"
  done
}

first_hotbar_slot=52x52-290+11

shot() {
  local full=$BENCH_TMP/views.png
  "$game" shot "$full" ${2:-} >/dev/null
  if [ "$1" = icon ]; then
    magick "$full" -gravity south -crop "$first_hotbar_slot" +repage -filter point -resize 400% "$dir/icon.png"
  else
    local width
    width=$(identify -format %w "$full")
    magick "$full" -gravity center -crop "${width}x$((width * ${3:-9} / 16))+0+0" +repage -resize 960x -quality 82 "$dir/$1.webp"
  fi
}

nearest() {
  "$game" state | jq -r --arg code "$1" '[.nearby[] | select(.code | test($code))] | last | .EntityId'
}

around() {
  look "$1" $(awk -v s="$s" -v x="$2" -v y="$3" -v z="$4" 'BEGIN { print x * s, y * s, z * s }')
}

views() {
  local code=$1 s=${3:-1} id at x y z
  dir=$2
  mkdir -p "$dir"
  local item=${code#game:}
  clear >/dev/null

  id=$(dock "$code" | jq -r '.vessels[0].EntityId')
  sleep 5
  around "$id" -5 1.4 0; shot afloat-side
  around "$id" -4 2.4 4; shot afloat-bow
  around "$id" -4 2.4 -4; shot afloat-stern
  around "$id" 0 7 0.01; shot afloat-above
  at=$("$game" entity "$id" | jq -r '.pos | "\(.X - 512000) \(.Y) \(.Z - 512000)"')
  read -r x y z <<<"$at"
  local apart
  apart=$(awk -v s="$s" 'BEGIN { print 3 + 2 * s }')
  "$game" do "/entity spawnat boat-sailed-oak 1 $(awk -v x="$x" -v d="$apart" 'BEGIN { print x + d }') $y $z 0" >/dev/null
  sleep 2
  local companion
  companion=$("$game" state | jq -r '[.nearby[] | select(.code == "game:boat-sailed-oak") | .EntityId] | max')
  "$game" do "/bridge fly $(awk -v x="$x" -v d="$apart" -v y="$y" -v z="$z" 'BEGIN { print x + d / 2, y + 6, z + 14 }')" >/dev/null
  "$game" look 3.1416 3.55 >/dev/null
  sleep 1; shot beside-sailboat
  "$game" do "/entity remove e[id=$companion]" >/dev/null

  "$game" do "/bridge strike $id 1000000000" >/dev/null
  sleep 2
  "$game" do "/bridge fly $(awk -v x="$x" 'BEGIN { print x - 3 }') $(awk -v y="$y" 'BEGIN { print y + 3 }') $z" >/dev/null
  "$game" look 1.5708 4.05 >/dev/null
  sleep 1; shot wreckage
  clear >/dev/null

  "$game" do '/bridge shore' >/dev/null
  sleep 5
  local shore
  shore=$("$game" do '/bridge shore')
  [[ $shore == *"over the shore"* ]] || { echo "$shore" >&2; exit 1; }
  "$game" do '/we mark ~-6 ~-1 ~-6 ~6 ~4 ~6' '/we delete' '/we clear' >/dev/null
  "$game" do "/entity spawnat $code 1 ~ ~-1 ~ 0" >/dev/null
  sleep 2
  id=$(nearest "$code")
  around "$id" -5 1.6 0; shot ashore-side
  around "$id" 4 2.6 4; shot ashore-quarter
  at=$("$game" entity "$id" | jq -r '.pos | "\(.X - 512000) \(.Y + 0.5) \(.Z - 512000)"')
  clear 16 >/dev/null
  "$game" do "/bridge drop $item $at" >/dev/null
  sleep 2
  around "$(nearest '^game:item$')" 2.5 1.8 2.5; shot dropped
  clear 16 >/dev/null

  "$game" do '/clearinv' >/dev/null
  "$game" slot 0 >/dev/null
  "$game" do "/bridge hold $item" >/dev/null
  "$game" look 0 3.3 >/dev/null
  shot icon gui
  "$game" hotkey cyclecamera >/dev/null
  "$game" hotkey cyclecamera >/dev/null
  sleep 1; shot held '' 16
  "$game" hotkey cyclecamera >/dev/null
  if "$game" do '/clearinv' "/bridge wear $item" | grep -q Wearing; then
    "$game" hotkey cyclecamera >/dev/null
    sleep 1; shot worn '' 16
    "$game" hotkey cyclecamera >/dev/null
    "$game" hotkey cyclecamera >/dev/null
    "$game" do '/clearinv' >/dev/null
  fi
  ls "$dir"
}

case "${1:-}" in
  views) shift; views "$@" ;;
  photo) shift; photo "$@" ;;
  dock) shift; dock "$@" ;;
  look) shift; look "$@" ;;
  storm) shift; storm "$@" ;;
  clear) shift; clear "$@" ;;
  *) usage ;;
esac
