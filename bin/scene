#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'EOF'
bin/scene dock [CODE...]   calm noon at open sea, the player in creative flying just above the surface;
                           each CODE (default boat-raft-oak boat-sailed-oak) is spawned unmanned
                           beside it, 4 blocks apart, and holds still. Prints the spawned entity ids.
                           A CODE without a domain is the game's; ours carry theirs: roughseas:dugout-oak.
bin/scene shallows [DEPTH]  after dock: a granite bed DEPTH whole metres (default 1) under the surface where
                           the player hovers, 25 blocks across and 85 along +z, the way a vessel spawned at
                           yaw 0 heads: water a pole reaches the bottom of.
bin/scene dress            the player in plain period clothes, a hunter's shirt, dark trousers and worn leather boots, as a player at
                           sea is in any picture made for others; a take of the bench world starts undressed.
bin/scene look ID [DX DY DZ]
                           the one way to look at anything: fly to entity ID's position plus DX DY DZ
                           (default 3 1 0: east of it and a block up), hover there and aim at it.
                           ID may be a point instead, X,Y,Z as commands take them (relative to the
                           world's spawn): blocks with no entity yet, such as logs laid out to build on.
                           A shot from any side, over land or sea; 0 6 0.01 looks straight down,
                           above the water's tint. `bin/game hotkey togglehud` hides the HUD.
bin/scene photo ID FILE [DX DY DZ] [hover]
                           a wiki-ready image (16:9 .webp, 960 wide) at noon of entity ID from where `look`
                           puts the camera, without the HUD; with `hover`, the panel the game shows
                           for what the crosshair is on (name, hull, bilge) is laid over its top.
bin/scene storm [RANGE [WAVES]] [CODE...]
                           noon, then the highest storm waves over open sea within RANGE blocks
                           (default 60000), or those nearest WAVES metres:
                           the player hovering 12 blocks above the surface, each CODE
                           (default boat-sailed-oak boat-raft-oak) riding below, 6 blocks apart, in one
                           sea state. Dangerous oceans on: the waves board, swamp, capsize and break them.
                           /worldconfig dangerousOceans false keeps them whole.
bin/scene clear [RANGE] [TYPE...]
                           remove entities of each TYPE (default every vessel and item; wildcards allowed,
                           e.g. drifter-*) within RANGE blocks (default 64) of the player. Blocks,
                           ropes tied to blocks and /worldconfig changes stay.
bin/scene views CODE DIR [SCALE]
                           every form a vessel takes at calm noon, as wiki-ready images in DIR, all at
                           the bench world's one spot: afloat in its lagoon zone from the side, the bow
                           and stern quarters and above; beside the vanilla sailboat; ashore on its beach
                           zone from the side and a quarter; dropped on the ground; held in the hand;
                           worn on the back (a vessel with a backpack slot); the wreckage it leaves
                           (16:9 .webp, 960 wide), and its hotbar slot (icon.png). SCALE (default 1)
                           moves the camera out for a bigger vessel.
                           It changes the world as it goes: clears vessels, items and wandering
                           animals around the player, breaks the vessel, weeds the beach, and empties
                           the player's inventory.
bin/scene seats [CODE...]  the player in every seat of each vessel (default: ours and the vanilla raft
                           and sailboat), seen at noon in third person from the left: CODE-SEAT.png per seat in
                           <temp>/seats, and all.png with them side by side. Checks the seats and poses.
bin/scene strokes [CODE[@TOOL]...]
                           the player rowing or paddling each vessel (default: ours with their own oars or paddle), forward and
                           backward, from the front, the side and behind, in third person: a burst
                           over one stroke per view, <temp>/strokes/CODE-STROKE-VIEW/sheet.png. With @TOOL the
                           rower holds that item (roughseas:dugout-oak@roughseas:paddle-oak), and the sheets are
                           named CODE-TOOL-STROKE-VIEW.
                           Checks the rower's arms frame by frame.
bin/scene recipe PAGE OUTPUT FILE [FROM]
                           the handbook's crafting grid that makes OUTPUT (out of FROM, when given) on
                           handbook page PAGE, held on that recipe, "=" and output included, as a .png
                           FILE at twice the game's size:
                           bin/scene recipe block-roughseas:reedbundle-papyrustops-none-we roughseas:reedbundle-papyrustops-none-we reedbundle.png.
                           Opens the handbook and waits for it to build its pages.
bin/scene recipes DIR      every recipe the mod adds, by `recipe`, into DIR: docs/wiki/images/recipes
                           for the wiki. A new recipe gets its line in this script's list.
Run them after bin/client.
EOF
}

game="$(dirname "$0")/game"

noon() {
  "$game" do '/time set 12:00' >/dev/null
}

outfit=(game:clothes-upperbody-hunter-shirt game:clothes-lowerbody-commoner-trousers game:clothes-foot-worn-leather-boots)

dress() {
  for piece in "${outfit[@]}"; do "$game" do "/bridge dress $piece" >/dev/null; done
}

calm() {
  noon
  "$game" do '/gamemode creative' '/weather setprecip -1' '/weather set clearsky' '/weather setw still' '/weather acp false' \
    '/entity remove e[range=64,type=game:pig-*]' '/entity remove e[range=64,type=game:deer-*]' >/dev/null
}

placed() {
  "$game" entity "$1" | jq -r --argjson c "$("$game" state | jq -c .centre)" --argjson dy "${2:-0}" '.pos | "\(.X - $c.X) \(.Y + $dy) \(.Z - $c.Z)"'
}

dock() {
  local codes=("$@")
  [ ${#codes[@]} -eq 0 ] && codes=(boat-raft-oak boat-sailed-oak)
  noon
  "$game" do '/gamemode creative' '/weather setprecip 0' '/weather set clearsky' \
    '/weather setw still' '/weather acp false' >/dev/null
  local sea
  sea=$("$game" do '/bridge sea')
  [[ $sea == *Hovering* ]] || { echo "$sea" >&2; exit 1; }
  local x=-4
  for code in "${codes[@]}"; do
    "$game" do "/entity spawnat $code 1 ~$x ~-2 ~-5 0" >/dev/null
    x=$((x + 4))
  done
  sleep 3
  "$game" state | jq -c --argjson codes "$(printf '%s\n' "${codes[@]}" | jq -R . | jq -s 'map(if contains(":") then . else "game:" + . end)')" \
    '{player: .pos, vessels: [.nearby[] | select(.code as $c | $codes | index($c)) | {EntityId, code}]}'
}

look() {
  local id=$1 dx=${2:-3} dy=${3:-1} dz=${4:-0} entity at
  if [[ $id == *,*,* ]]; then
    local x y z
    IFS=, read -r x y z <<<"$id"
    "$game" do "/bridge fly $(awk -v x="$x" -v y="$y" -v z="$z" -v dx="$dx" -v dy="$dy" -v dz="$dz" 'BEGIN { print x + dx, y + dy, z + dz }')" >/dev/null
    "$game" look $(awk -v dx="$dx" -v dy="$dy" -v dz="$dz" \
      'BEGIN { pi = atan2(0, -1); print atan2(-dx, -dz), pi + atan2(dy + 1.6, sqrt(dx * dx + dz * dz)) }') >/dev/null
    return
  fi
  entity=$("$game" entity "$id")
  [[ $entity == {* ]] || { echo "$entity" >&2; exit 1; }
  at=$(jq -r --argjson c "$("$game" state | jq -c .centre)" --argjson dx "$dx" --argjson dy "$dy" --argjson dz "$dz" <<<"$entity" \
    '.pos | "\(.X - $c.X + $dx) \(.Y + $dy) \(.Z - $c.Z + $dz)"')
  "$game" do "/bridge fly $at" >/dev/null
  "$game" aim "$id" >/dev/null
}

photo() {
  local id=$1 out=$2 hover=
  shift 2
  [ "${!#:-}" = hover ] && { hover=hover; set -- "${@:1:$#-1}"; }
  noon
  look "$id" "${1:-3}" "${2:-1}" "${3:-0}"
  sleep 2
  local clean=$BENCH_TMP/photo.png gui=$BENCH_TMP/photo-gui.png width height
  [ "$hover" = hover ] && "$game" do '/time stop' >/dev/null
  "$game" shot "$clean" >/dev/null
  read -r width height <<<"$(identify -format '%w %h' "$clean")"
  local layers=("$clean" -gravity center -crop "${width}x$((width * 9 / 16))+0+0" +repage)
  if [ "$hover" = hover ]; then
    "$game" hover "$id" >/dev/null
    sleep 1
    "$game" shot "$gui" gui >/dev/null
    "$game" hover >/dev/null
    "$game" do '/time resume' >/dev/null
    local quarter=$((width / 4)) panel
    panel=$(magick "$clean" "$gui" -compose difference -composite -crop "$((quarter * 2))x$((height / 6))+${quarter}+0" +repage \
      -colorspace gray -threshold 8% -trim -format '%wx%h+%[fx:page.x+'"$quarter"']+%[fx:page.y]' info:)
    magick "$gui" -crop "$panel" +repage "$BENCH_TMP/panel.png"
    layers=("$clean" "$BENCH_TMP/panel.png" -gravity northwest -geometry "+${panel#*+}" -composite
      -gravity center -crop "${width}x$((width * 9 / 16))+0+0" +repage)
  fi
  magick "${layers[@]}" -resize 960x -quality 82 "$out"
}

storm() {
  local numbers=()
  while [[ ${1:-} =~ ^[0-9.]+$ ]]; do numbers+=("$1"); shift; done
  local codes=("$@")
  [ ${#codes[@]} -eq 0 ] && codes=(boat-sailed-oak boat-raft-oak)
  "$game" do '/gamemode creative' '/time set 12:00' '/worldconfig dangerousOceans true' >/dev/null
  local storm
  storm=$("$game" do "/bridge storm ${numbers[*]}")
  echo "$storm"
  [[ $storm == *Hovering* ]] || exit 1
  "$game" do '/bridge fly ~ ~11 ~' >/dev/null
  local x=$(( -3 * (${#codes[@]} - 1) ))
  for code in "${codes[@]}"; do
    "$game" do "/entity spawnat $code 1 ~$x 109 ~-8 0" >/dev/null
    x=$((x + 6))
  done
  "$game" do '/seas here'
}

shallows() {
  local bed=$((${1:-1} + 2))
  "$game" do '/bridge hold game:rock-granite' "/we mark ~-12 ~-$bed ~-12 ~12 ~-$bed ~72" '/we fill' '/we clear' \
    '/clearinv' >/dev/null
}

clear() {
  local range=${1:-64}
  shift || true
  local types=("$@")
  [ ${#types[@]} -eq 0 ] && types=(boat-* roughseas:reedboat-* roughseas:dugout-* roughseas:coracle roughseas:barkcanoe-* roughseas:currach roughseas:outrigger-* item)
  for type in "${types[@]}"; do
    "$game" do "/entity remove e[type=$type,range=$range]"
  done
}

first_hotbar_slot=52x52-290+11

shot() {
  local full=$BENCH_TMP/views.png
  "$game" shot "$full" ${2:-} >/dev/null
  if [ "$1" = icon ]; then
    magick "$full" -gravity south -crop "$first_hotbar_slot" +repage -filter point -resize 400% "$dir/icon.png"
  else
    local width
    width=$(identify -format %w "$full")
    magick "$full" -gravity center -crop "${width}x$((width * ${3:-9} / 16))+0+0" +repage -resize 960x -quality 82 "$dir/$1.webp"
  fi
}

nearest() {
  "$game" state | jq -r --arg code "$1" '[.nearby[] | select(.code | test($code))] | last | .EntityId'
}

around() {
  look "$1" $(awk -v s="$s" -v x="$2" -v y="$3" -v z="$4" 'BEGIN { print x * s, y * s, z * s }')
}

views() {
  local code=$1 s=${3:-1} id at x y z
  dir=$2
  mkdir -p "$dir"
  local item=${code#game:}
  clear >/dev/null

  calm
  "$game" zone lagoon >/dev/null
  id=$("$game" do "/bridge spawn $code ~ ~-2 ~ 90" | awk '/Spawned/ { print $NF }')
  sleep 5
  around "$id" 0 1.1 4.5; shot afloat-side
  around "$id" 3.2 1.8 3.4; shot afloat-bow
  around "$id" -3.2 1.8 3.4; shot afloat-stern
  around "$id" 0 7 0.01; shot afloat-above
  at=$(placed "$id")
  read -r x y z <<<"$at"
  local apart companion
  apart=$(awk -v s="$s" 'BEGIN { print 4 + 2 * s }')
  companion=$("$game" do "/bridge spawn boat-sailed-oak $x $y $(awk -v z="$z" -v d="$apart" 'BEGIN { print z - d }') 90" | awk '/Spawned/ { print $NF }')
  sleep 2
  "$game" do "/bridge fly $x $(awk -v y="$y" -v s="$s" 'BEGIN { print y + 3 + s }') $(awk -v z="$z" -v s="$s" 'BEGIN { print z + 7 + 3 * s }')" >/dev/null
  "$game" look 3.1416 3.5 >/dev/null
  sleep 1; shot beside-sailboat
  "$game" do "/entity remove e[id=$companion]" >/dev/null
  clear >/dev/null

  "$game" zone beach >/dev/null
  noon
  "$game" do '/bridge weed 8' >/dev/null
  id=$("$game" do "/bridge spawn $code ~ ~-2 ~ 90" | awk '/Spawned/ { print $NF }')
  sleep 2
  around "$id" 0 1.4 4.5; shot ashore-side
  around "$id" 3.5 2.4 3.5; shot ashore-quarter
  at=$(placed "$id" 0.5)
  read -r x y z <<<"$(placed "$id")"
  "$game" do "/bridge strike $id 1000000000" >/dev/null
  sleep 2
  "$game" do "/bridge fly $x $(awk -v y="$y" -v s="$s" 'BEGIN { print y + 2.5 * s }') $(awk -v z="$z" -v s="$s" 'BEGIN { print z + 2.5 * s }')" >/dev/null
  "$game" look 3.1416 4.1 >/dev/null
  sleep 1; shot wreckage
  clear 16 >/dev/null
  "$game" do "/bridge drop $item $at" >/dev/null
  sleep 2
  around "$(nearest '^game:item$')" 2.5 1.8 2.5; shot dropped
  clear 16 >/dev/null

  "$game" do '/clearinv' >/dev/null
  dress
  "$game" slot 0 >/dev/null
  "$game" do "/bridge hold $item" >/dev/null
  "$game" look 0 3.3 >/dev/null
  shot icon gui
  "$game" hotkey cyclecamera >/dev/null
  "$game" hotkey cyclecamera >/dev/null
  sleep 1; shot held '' 16
  "$game" hotkey cyclecamera >/dev/null
  if "$game" do '/clearinv' "/bridge wear $item" | grep -q Wearing && dress; then
    "$game" hotkey cyclecamera >/dev/null
    sleep 1; shot worn '' 16
    "$game" hotkey cyclecamera >/dev/null
    "$game" hotkey cyclecamera >/dev/null
    "$game" do '/clearinv' >/dev/null
  fi
  ls "$dir"
}

seats() {
  local codes=("$@") dir=$BENCH_TMP/seats id
  [ ${#codes[@]} -eq 0 ] && codes=(roughseas:reedboat-cattailtops-cattailtops roughseas:coracle roughseas:barkcanoe-birch roughseas:currach \
    roughseas:dugout-oak roughseas:outrigger-oak boat-raft-oak boat-sailed-oak)
  mkdir -p "$dir"
  local shots=() seat
  for code in "${codes[@]}"; do
    clear >/dev/null
    id=$(dock "$code" | jq -r '.vessels[0].EntityId')
    seat=0
    while "$game" do "/bridge mount $id $seat" | grep -q Seated; do
      noon
      "$game" hotkey cyclecamera >/dev/null
      "$game" look 1.5708 3.35 >/dev/null
      sleep 3
      shots+=("$dir/${code##*:}-$seat.png")
      "$game" shot "${shots[-1]}" >/dev/null
      "$game" hotkey cyclecamera >/dev/null
      "$game" hotkey cyclecamera >/dev/null
      "$game" do '/bridge dismount' >/dev/null
      seat=$((seat + 1))
    done
  done
  magick "${shots[@]}" -resize 25% +append "$dir/all.png"
  echo "$dir/all.png"
}

strokes() {
  local codes=("$@") dir=strokes id
  for entry in "${codes[@]}"; do
    local code=${entry%@*} tool=
    [[ $entry == *@* ]] && tool=${entry#*@}
    clear >/dev/null
    id=$(dock "$code" | jq -r '.vessels[0].EntityId')
    "$game" do '/clearinv' >/dev/null
    [ -n "$tool" ] && "$game" do "/bridge hold $tool" >/dev/null
    "$game" do "/bridge mount $id" >/dev/null
    noon
    "$game" hotkey cyclecamera >/dev/null
    for _ in {1..30}; do "$game" hotkey zoomin >/dev/null; done
    for _ in {1..6}; do "$game" hotkey zoomout >/dev/null; done
    local stroke key view yaw
    for stroke in forward:W backward:S; do
      key=${stroke#*:}
      for view in front:3.1416 side:1.5708 behind:0; do
        yaw=${view#*:}
        "$game" look "$yaw" 3.35 >/dev/null
        "$game" press "$key" 3500 >/dev/null &
        sleep 1.2
        local held=${tool##*:}
        local frames=$BENCH_TMP/$dir/${code##*:}${held:+-${held%%-*}}-${stroke%:*}-${view%:*}
        "$game" burst "${frames#"$BENCH_TMP"/}" 16 2 >/dev/null
        wait
        magick montage -label '%t' "$frames"/[0-9]*.png -gravity center -crop 400x340+0+30 +repage \
          -tile 4x -geometry 400x340+2+2 "$frames/sheet.png"
        echo "$frames/sheet.png"
      done
    done
    "$game" hotkey cyclecamera >/dev/null
    "$game" hotkey cyclecamera >/dev/null
    "$game" do '/bridge dismount' >/dev/null
  done
}

recipe() {
  local page=$1 output=$2 out=$3 from=${4:-} box deadline=$((SECONDS + 60))
  "$game" state | jq -e '.dialogs | index("GuiDialogSurvivalHandbook")' >/dev/null || "$game" hotkey handbook >/dev/null
  until "$game" link "handbook://$page" >/dev/null && box=$("$game" recipe "$output" "$from" 2>/dev/null); do
    [ $SECONDS -lt $deadline ] || { echo "No recipe makes $output${from:+ from $from} on handbook page $page" >&2; exit 1; }
    sleep 2
  done
  local full=$BENCH_TMP/recipe.png
  "$game" shot "$full" gui >/dev/null
  magick "$full" -crop "$(jq -r '"\(.width)x\(.height)+\(.x)+\(.y)"' <<<"$box")" +repage -filter point -resize 200% "$out"
}

recipes() {
  local dir=$1 name page output from
  mkdir -p "$dir"
  while read -r name page output from; do
    recipe "$page" "$output" "$dir/$name.png" "$from"
  done <<'EOF'
birch-bark         item-roughseas:bark-birch         roughseas:bark-birch
splitting-wedge    block-roughseas:wedge-we          roughseas:wedge-we
reed-bundle        block-roughseas:reedbundle-cattailtops-none-we roughseas:reedbundle-cattailtops-none-we
laths              item-roughseas:lath-oak-5-dry     roughseas:lath-oak-5-dry
anchor-warp        item-roughseas:anchorwarp         roughseas:anchorwarp
paddle             item-roughseas:paddle-oak         roughseas:paddle-oak
thole-oar          item-roughseas:tholeoar-oak       roughseas:tholeoar-oak
anchor-warp-ropes  item-rope                         game:rope                    roughseas:anchorwarp
EOF
  "$game" close >/dev/null
  ls "$dir"
}

case "${1:-}" in
  recipe) shift; recipe "$@" ;;
  recipes) shift; recipes "$@" ;;
  views) shift; views "$@" ;;
  seats) shift; seats "$@" ;;
  strokes) shift; strokes "$@" ;;
  photo) shift; photo "$@" ;;
  dock) shift; dock "$@" ;;
  shallows) shift; shallows "$@" ;;
  dress) dress ;;
  look) shift; look "$@" ;;
  storm) shift; storm "$@" ;;
  clear) shift; clear "$@" ;;
  *) usage ;;
esac
