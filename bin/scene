#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'EOF'
bin/scene dock [CODE...]   calm noon at open sea, the player in creative standing on a granite post
                           at the surface; each CODE (default boat-raft-oak boat-sailed-oak) is
                           spawned unmanned beside it, 4 blocks apart. Prints the spawned entity ids.
                           A CODE without a domain is the game's; ours carry theirs: roughseas:dugout-oak.
bin/scene slab CODE        a dry look at a vessel: CODE spawned on a granite slab above the sea, north
                           of the player, who stands 3 blocks higher and looks down at it. Run after
                           dock. Prints the entity id. `bin/game hotkey togglehud` hides the HUD.
bin/scene look ID [DX DY DZ]
                           fly the player (/bridge fly) to entity ID's position plus DX DY DZ
                           (default 3 1 0: east of it and a block up), hover there and aim at it:
                           a shot from any side, over land or sea.
bin/scene storm [RANGE]    noon, then the highest storm waves over open sea within RANGE blocks
                           (default 60000): the player hovering 12 blocks above the surface,
                           a sailboat and a raft riding below, dangerous oceans off so they last.
                           Turn it back on with /worldconfig dangerousOceans true.
bin/scene clear [RANGE] [TYPE...]
                           remove entities of each TYPE (default every vessel and item; wildcards allowed,
                           e.g. drifter-*) within RANGE blocks (default 64) of the player. Run it
                           after each test, so one world serves the next.
Run them after bin/client and bin/game wait.
EOF
}

game="$(dirname "$0")/game"

dock() {
  local codes=("$@")
  [ ${#codes[@]} -eq 0 ] && codes=(boat-raft-oak boat-sailed-oak)
  "$game" do '/gamemode creative' '/time set 12:00' '/weather setprecip 0' '/weather set clearsky' \
    '/weather setw still' '/weather acp false' >/dev/null
  local sea x z
  sea=$("$game" do '/bridge sea')
  read -r x z < <(sed -n 's/.*open sea at \(-\?[0-9]*\) [0-9]* \(-\?[0-9]*\).*/\1 \2/p' <<<"$sea")
  [ -n "${x:-}" ] || { echo "$sea" >&2; exit 1; }
  until "$game" state | jq -e --argjson x $((512000 + x)) --argjson z $((512000 + z)) \
    '(.pos.X - $x - 0.5 | fabs) < 1 and (.pos.Z - $z - 0.5 | fabs) < 1' >/dev/null; do sleep 1; done
  until "$game" state | jq -e '.pos.Y >= 109.9' >/dev/null; do sleep 1; done
  local x=-4
  for code in "${codes[@]}"; do
    "$game" do "/entity spawnat $code 1 ~$x ~-1 ~-5 0" >/dev/null
    x=$((x + 4))
  done
  sleep 3
  "$game" state | jq -c --argjson codes "$(printf '%s\n' "${codes[@]}" | jq -R . | jq -s 'map(if contains(":") then . else "game:" + . end)')" \
    '{player: .pos, vessels: [.nearby[] | select(.code as $c | $codes | index($c)) | {EntityId, code}]}'
}

slab() {
  local code=$1
  "$game" slot 0 >/dev/null
  "$game" do '/giveblock rock-granite 64' '/we mark ~-3 110 ~-8 ~3 110 ~-2' '/we fill' \
    '/we mark ~ 110 ~ ~ 112 ~' '/we fill' '/we clear' '/tp ~ 113 ~' >/dev/null
  until "$game" state | jq -e '.pos.Y >= 112.9' >/dev/null; do sleep 1; done
  "$game" do "/entity spawnat $code 1 ~ 111 ~-5 0" >/dev/null
  sleep 2
  "$game" look 3.1416 4.2 >/dev/null
  [[ $code == *:* ]] || code=game:$code
  "$game" state | jq -r --arg code "$code" '[.nearby[] | select(.code == $code)][0].EntityId'
}

look() {
  local id=$1 dx=${2:-3} dy=${3:-1} dz=${4:-0} at
  at=$("$game" entity "$id" | jq -r --argjson dx "$dx" --argjson dy "$dy" --argjson dz "$dz" \
    '.pos | "\(.X - 512000 + $dx) \(.Y + $dy) \(.Z - 512000 + $dz)"')
  read -r x y z <<<"$at"
  "$game" do "/bridge fly $at" >/dev/null
  until "$game" state | jq -e --argjson x "$x" --argjson z "$z" \
    '(.pos.X - 512000 - $x | fabs) < 1 and (.pos.Z - 512000 - $z | fabs) < 1' >/dev/null; do sleep 1; done
  "$game" aim "$id" >/dev/null
}

storm() {
  "$game" do '/gamemode creative' '/time set 12:00' '/worldconfig dangerousOceans false' >/dev/null
  local from
  from=$("$game" state | jq -c '.pos')
  "$game" do "/bridge storm ${1:-}"
  local tries=60
  until "$game" state | jq -e --argjson from "$from" \
    '(.pos.Y - 110 | fabs) < 0.5 and ((.pos.X - $from.X) * (.pos.X - $from.X) + (.pos.Z - $from.Z) * (.pos.Z - $from.Z)) > 4096' >/dev/null; do
    tries=$((tries - 1))
    [ "$tries" -gt 0 ] || { echo "No post went up at the storm within a minute; see the chat" >&2; exit 1; }
    sleep 1
  done
  "$game" do '/bridge fly ~ ~12 ~' \
    '/entity spawnat boat-sailed-oak 1 ~-6 109 ~-8 0' '/entity spawnat boat-raft-oak 1 ~6 109 ~-8 0' >/dev/null
  "$game" do '/seas here'
}

clear() {
  local range=${1:-64}
  shift || true
  local types=("$@")
  [ ${#types[@]} -eq 0 ] && types=(boat-* roughseas:reedboat roughseas:dugout-* roughseas:coracle roughseas:barkcanoe roughseas:currach roughseas:outrigger-* item)
  for type in "${types[@]}"; do
    "$game" do "/entity remove e[type=$type,range=$range]"
  done
}

case "${1:-}" in
  dock) shift; dock "$@" ;;
  slab) shift; slab "$@" ;;
  look) shift; look "$@" ;;
  storm) shift; storm "$@" ;;
  clear) shift; clear "$@" ;;
  *) usage ;;
esac
