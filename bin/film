#!/usr/bin/env -S uv run --quiet --script
# /// script
# requires-python = ">=3.10"
# dependencies = ["pyyaml>=6"]
# ///
"""Film a scene from a screenplay in one run: bin/film SCREENPLAY.yml

  bin/film SCREENPLAY [--out DIR] [--no-captions]
                       set the scene up off camera, shoot every scene in one take with the game's own
                       recorder (.vrec), clear what the screenplay created and print the video, then one
                       still per scene, taken as the scene ends. Captions are burned in after the take.
  bin/film scout SCREENPLAY [STATION...] [--out DIR]
                       set the scene up, take a still from each named station (all by default) and
                       clear it again: the angles are checked before the take.
  bin/film help        this text.

Run it after bin/client, on a world with open sea near the player. Renders land in
~/Videos/<project>/<screenplay>/ ($XDG_VIDEOS_DIR when set), outside the repository; the
screenplay is the file worth keeping, in thoughts/shared/screenplays/YYYY-MM-DD/<slug>.yml.
A failed scene is named, its picture saved as failure.png, and the world cleared as after a take.

SCREENPLAY
  setting:             before the recording starts, never on camera
    place: sea         sea (/bridge sea), shore (/bridge shore), {force: N} (/bridge force N), or
                       [X, Y, Z] as commands take them. The search starts where the player is, and
                       the run ends by flying the player back there, so a second run films the
                       same place.
    time: "10:00"      /time set; it only moves the clock forward
    weather: calm      clear sky, still wind, no rain, patterns held; or a list of commands. The
                       rain is handed back to the weather (/weather setprecipa) after the take.
    do: [COMMAND...]   anything else, run in order
  cast:                entities spawned for the film and removed after it, by name
    currach: {spawn: roughseas:currach, at: [0, 0, 6], yaw: 0}
                       at: blocks from the player at the place (default where the player is); yaw
                       in degrees. A vessel over water lies on the surface.
  player:
    ride: currach      seated in a cast member, its steering seat first
    hold: CODE         the item in hand (/bridge hold)
  stations:            named camera stations, which `scout` shoots
    abeam: {around: currach, bearing: 90, distance: 9, height: 3, look: currach, hold: false}
                       around a cast member or `player`; bearing in degrees clockwise from its heading
                       (0 ahead, 90 to starboard, 180 astern); distance and height in blocks; looking
                       at `look` (default `around`). It follows the entity; with hold: true it stays
                       where the entity was when the shot began, as a tripod does.
  scenes:              shot in order, in one take
  - name: Rowing out
    say: "..."         the caption, held as long as reading it takes (2.7 words a second)
    camera: abeam      a station, inline or by name; first or third, the game's own views from the
                       player; or a move between two stations on one entity:
                       {from: abeam, to: astern, seconds: 12}
    do: [ACTION...]    in order, when the scene begins. An action is a command (/server or .client;
                       {name} stands for a cast member's id) or one of
                       {fly: [X, Y, Z]}  {mount: NAME}  {dismount: true}  {aim: NAME}
                       {hand: CODE}  {use: NAME}
    keys: [W]          held through the scene: W/S row, A/D steer
    until:             what only success produces; the scene goes on until it holds
                       {moved: NAME, by: BLOCKS}    NAME has moved that far since the scene began
                       {near: NAME, to: NAME, within: BLOCKS}
                       {afloat: NAME}               a vessel not sunk
    timeout: 120       seconds until fails the scene
  A scene lasts until its until holds, its camera has moved and its caption has been read. Nothing
  waits a fixed pause.
"""
import argparse
import math
import os
import pathlib
import re
import shutil
import signal
import subprocess
import sys
import time

import yaml

ROOT = pathlib.Path(__file__).resolve().parent.parent
GAME = ROOT / "bin" / "game"
WORDS_PER_SECOND = 2.7
MINIMUM_DWELL_SECONDS = 2.0
POLL_SECONDS = 0.5
ENTITY_WAIT_SECONDS = 30
DEFAULT_TIMEOUT = 120
CALM = ["/weather setprecip 0", "/weather set clearsky", "/weather setw still", "/weather acp false"]


class Failure(Exception):
    pass


class Game:
    def run(self, *args):
        result = subprocess.run([str(GAME), *map(str, args)], capture_output=True, text=True)
        if result.returncode != 0:
            raise Failure(f"bin/game {' '.join(map(str, args))}: {(result.stdout + result.stderr).strip()}")
        return result.stdout

    def do(self, line):
        return self.run("do", line).strip()

    def expect(self, line, success):
        reply = self.do(line)
        if success not in reply:
            raise Failure(f"{line}: {reply}")
        return reply

    def state(self):
        return yaml.safe_load(self.run("state"))

    def where(self, id):
        return yaml.safe_load(self.run("where", "" if id == "player" else id))

    def camera(self, *query):
        return self.run("camera", *query)

    def shot(self, path, recording=False):
        self.run("shot", path, *(["gui"] if recording else []))
        pathlib.Path(str(path).removesuffix(".png") + "-small.png").unlink(missing_ok=True)


class Screenplay:
    def __init__(self, path):
        self.path = pathlib.Path(path)
        if not self.path.is_file():
            raise Failure(f"No such screenplay: {self.path}")
        data = yaml.safe_load(self.path.read_text())
        if not isinstance(data, dict) or not data.get("scenes"):
            raise Failure("A screenplay is a mapping with a non-empty scenes: list")
        self.setting = data.get("setting") or {}
        self.cast = data.get("cast") or {}
        self.player = data.get("player") or {}
        self.stations = data.get("stations") or {}
        self.scenes = data["scenes"]
        self.slug = self.path.stem


class Set:
    def __init__(self, game, screenplay):
        self.game = game
        self.screenplay = screenplay
        self.ids = {}
        self.home = None
        self.calm = False

    def build(self):
        state = self.game.state()
        self.home = [state["pos"]["X"] - state["centre"]["X"], state["pos"]["Y"], state["pos"]["Z"] - state["centre"]["Z"]]
        if state.get("mountedOn"):
            self.game.do("/bridge dismount")
        setting = self.screenplay.setting
        self.place(setting.get("place", "sea"))
        if "time" in setting:
            self.game.do(f"/time set {setting['time']}")
        weather = setting.get("weather")
        self.calm = weather == "calm"
        for line in CALM if self.calm else weather or []:
            self.game.do(line)
        for line in setting.get("do") or []:
            self.game.do(self.cue(line))
        for name, member in self.screenplay.cast.items():
            dx, dy, dz = member.get("at", [0, 0, 0])
            reply = self.game.expect(f"/bridge spawn {member['spawn']} ~{dx} ~{dy} ~{dz} {member.get('yaw', 0)}", "Spawned")
            self.ids[name] = int(reply.split()[-1])
        player = self.screenplay.player
        if "hold" in player:
            self.game.expect(f"/bridge hold {player['hold']}", "Holding")
        if "ride" in player:
            self.game.expect(f"/bridge mount {self.id(player['ride'])}", "Seated")

    def place(self, place):
        if place in ("sea", "shore"):
            line = f"/bridge {place}"
        elif isinstance(place, dict) and "force" in place:
            line = f"/bridge force {place['force']}"
        elif isinstance(place, list) and len(place) == 3:
            line = "/bridge fly {} {} {}".format(*place)
        else:
            raise Failure(f"A place is sea, shore, {{force: N}} or [X, Y, Z], not {place!r}")
        self.game.expect(line, "Hovering")

    def clear(self):
        interrupt = signal.signal(signal.SIGINT, signal.SIG_IGN)
        steps = [lambda: self.game.do(".vrec stop"), lambda: self.game.camera("first"),
                 lambda: self.game.run("press", "W,A,S,D", "up"), lambda: self.game.do(".gui on"),
                 lambda: self.game.do("/bridge dismount"),
                 *(lambda id=id: self.game.do(f"/entity remove e[id={id}]") for id in self.ids.values())]
        if self.calm:
            steps += [lambda: self.game.do("/weather setprecipa"), lambda: self.game.do("/weather acp true")]
        if self.home:
            steps.append(lambda: self.game.do("/bridge fly {:.1f} {:.1f} {:.1f}".format(*self.home)))
        for step in steps:
            try:
                step()
            except Failure as failure:
                print(f"Clearing up: {failure}", file=sys.stderr)
        signal.signal(signal.SIGINT, interrupt)

    def id(self, name):
        if name == "player":
            return "player"
        if name not in self.ids:
            raise Failure(f"No one called {name} in the cast")
        return self.ids[name]

    def cue(self, line):
        return re.sub(r"\{(\w+)\}", lambda match: str(self.ids.get(match.group(1), match.group(0))), line)


class Camera:
    def __init__(self, game, set):
        self.game = game
        self.set = set

    def station(self, spec):
        if isinstance(spec, str):
            if spec not in self.set.screenplay.stations:
                raise Failure(f"No station {spec}")
            spec = self.set.screenplay.stations[spec]
        return spec

    def frame(self, spec):
        if spec in ("first", "third"):
            self.game.camera(spec)
            return 0
        if isinstance(spec, dict) and "from" in spec:
            start, end = self.station(spec["from"]), self.station(spec["to"])
            if end.get("around", "player") != start.get("around", "player"):
                raise Failure("A camera moves between two stations on one entity")
            seconds = spec.get("seconds", 10)
            moving = [f"seconds={seconds}", f"toBearing={end.get('bearing', 0)}",
                      f"toDistance={end.get('distance', 8)}", f"toHeight={end.get('height', 2)}"]
        else:
            start, seconds, moving = self.station(spec), 0, []
        query = [f"on={self.set.id(start.get('around', 'player'))}", f"bearing={start.get('bearing', 0)}",
                 f"distance={start.get('distance', 8)}", f"height={start.get('height', 2)}", *moving]
        if "look" in start:
            query.append(f"look={self.set.id(start['look'])}")
        if start.get("hold"):
            query.append("hold=1")
        deadline = time.monotonic() + ENTITY_WAIT_SECONDS
        while True:
            try:
                self.game.camera(*query)
                return seconds
            except Failure as failure:
                if "No entity" not in str(failure) or time.monotonic() > deadline:
                    raise
                time.sleep(POLL_SECONDS)


class Scene:
    def __init__(self, game, set, camera, scene):
        self.game = game
        self.set = set
        self.camera = camera
        self.scene = scene
        self.name = scene.get("name", "scene")

    def dwell(self):
        say = self.scene.get("say")
        return max(len(say.split()) / WORDS_PER_SECOND, MINIMUM_DWELL_SECONDS) if say else 0

    def play(self, still):
        began = time.monotonic()
        seconds = self.camera.frame(self.scene["camera"]) if "camera" in self.scene else 0
        for action in self.scene.get("do") or []:
            self.act(action)
        keys = ",".join(self.scene.get("keys") or [])
        if keys:
            self.game.run("press", keys, "down")
        try:
            self.wait(self.scene.get("until"), began + max(seconds, self.dwell()), began + self.scene.get("timeout", DEFAULT_TIMEOUT))
            self.game.shot(still, recording=True)
        finally:
            if keys:
                self.game.run("press", keys, "up")

    def act(self, action):
        if isinstance(action, str):
            self.game.do(self.set.cue(action))
            return
        if not isinstance(action, dict) or len(action) != 1:
            raise Failure(f"An action is a command or a single-key mapping, not {action!r}")
        (verb, value), = action.items()
        if verb == "fly":
            self.game.expect("/bridge fly {} {} {}".format(*value), "Hovering")
        elif verb == "mount":
            self.game.expect(f"/bridge mount {self.set.id(value)}", "Seated")
        elif verb == "dismount":
            self.game.do("/bridge dismount")
        elif verb == "aim":
            self.game.run("aim", self.set.id(value))
        elif verb == "hand":
            self.game.expect(f"/bridge hold {value}", "Holding")
        elif verb == "use":
            self.game.do(f"/bridge interact {self.set.id(value)} interact")
        else:
            raise Failure(f"Unknown action {verb}")

    def wait(self, until, earliest, deadline):
        check = self.condition(until)
        while not (check() and time.monotonic() >= earliest):
            if time.monotonic() > deadline:
                raise Failure(f"{until} did not hold within the scene's timeout")
            time.sleep(POLL_SECONDS)

    def position(self, name):
        pos = self.game.where(self.set.id(name))
        return pos["X"], pos["Y"], pos["Z"]

    def condition(self, until):
        if not until:
            return lambda: True
        if "moved" in until:
            x, _, z = self.position(until["moved"])
            return lambda: math.dist((x, z), self.position(until["moved"])[::2]) >= until["by"]
        if "near" in until:
            return lambda: math.dist(self.position(until["near"]), self.position(until["to"])) <= until["within"]
        if "afloat" in until:
            return lambda: "sunk False" in self.game.do(f"/bridge strike {self.set.id(until['afloat'])} 0")
        raise Failure(f"Unknown until: {until}")


def videos_root():
    configured = os.environ.get("XDG_VIDEOS_DIR")
    return pathlib.Path(configured) if configured else pathlib.Path("~/Videos").expanduser()


def project():
    remote = subprocess.run(["git", "-C", str(ROOT), "remote", "get-url", "origin"], capture_output=True, text=True).stdout.strip()
    return pathlib.Path(remote).stem if remote else ROOT.name


def slugify(text):
    return re.sub(r"[^a-z0-9]+", "-", text.lower()).strip("-")


def timestamp(seconds):
    centis = round(seconds * 100)
    return f"{centis // 360000}:{centis // 6000 % 60:02}:{centis // 100 % 60:02}.{centis % 100:02}"


def probe(video):
    out = subprocess.run(["ffprobe", "-v", "error", "-select_streams", "v:0", "-show_entries", "stream=width,height:format=duration",
                          "-of", "default=noprint_wrappers=1", str(video)], capture_output=True, text=True, check=True).stdout
    values = dict(line.split("=", 1) for line in out.split())
    return int(values["width"]), int(values["height"]), float(values["duration"])


def subtitles(path, captions, width, height):
    events = "\n".join(f"Dialogue: 0,{timestamp(start)},{timestamp(end)},Caption,,0,0,0,,"
                       + text.replace("{", "(").replace("}", ")").replace("\n", " ") for start, end, text in captions)
    path.write_text(f"""[Script Info]
ScriptType: v4.00+
PlayResX: {width}
PlayResY: {height}
WrapStyle: 0

[V4+ Styles]
Format: Name, Fontname, Fontsize, PrimaryColour, SecondaryColour, OutlineColour, BackColour, Bold, Italic, Underline, StrikeOut, ScaleX, ScaleY, Spacing, Angle, BorderStyle, Outline, Shadow, Alignment, MarginL, MarginR, MarginV, Encoding
Style: Caption,Sans,{round(height * 0.034)},&H00FFFFFF,&H00FFFFFF,&H30111111,&H30111111,1,0,0,0,100,100,0,0,3,{round(height * 0.012)},0,2,{round(width * 0.1)},{round(width * 0.1)},{round(height * 0.06)},1

[Events]
Format: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, Text
{events}
""")


def encode(raw, mp4, captions, wall, ass):
    width, height, duration = probe(raw)
    # .vrec writes one frame at most per frame drawn; the captions are timed on the wall clock.
    filters =[f"setpts=PTS*{wall / duration:.6f}", "fps=30", "scale=trunc(iw/2)*2:trunc(ih/2)*2"]
    if captions:
        subtitles(ass, captions, width, height)
        filters.append(f"subtitles=filename='{ass}'")
    subprocess.run(["ffmpeg", "-y", "-loglevel", "error", "-i", str(raw), "-vf", ",".join(filters),
                    "-c:v", "libx264", "-preset", "veryfast", "-crf", "20", "-pix_fmt", "yuv420p", str(mp4)], check=True)


def film(screenplay, out, captions):
    game = Game()
    set = Set(game, screenplay)
    camera = Camera(game, set)
    raw_dir = out / "raw"
    shutil.rmtree(raw_dir, ignore_errors=True)
    raw_dir.mkdir(parents=True)
    mp4 = out / f"{screenplay.slug}.mp4"
    for stale in [mp4, out / "failure.png", *out.glob("[0-9][0-9]-*.png")]:
        stale.unlink(missing_ok=True)

    stills, marks, number = [], [], 0
    try:
        print("Setting the scene", file=sys.stderr)
        set.build()
        game.do(f".vrec filetarget {raw_dir}")
        game.do(".gui off")
        if opening := screenplay.scenes[0].get("camera"):
            camera.frame(opening["from"] if isinstance(opening, dict) and "from" in opening else opening)
        started = time.monotonic()
        game.do(".vrec start")
        for number, data in enumerate(screenplay.scenes, 1):
            scene = Scene(game, set, camera, data)
            print(f"Scene {number}: {scene.name}", file=sys.stderr)
            begins = time.monotonic() - started
            still = out / f"{number:02}-{slugify(scene.name)}.png"
            scene.play(still)
            stills.append(still)
            if data.get("say"):
                marks.append((begins, time.monotonic() - started, data["say"]))
        game.do(".vrec stop")
        wall = time.monotonic() - started
    except (Failure, subprocess.CalledProcessError, KeyboardInterrupt) as failure:
        signal.signal(signal.SIGINT, signal.SIG_IGN)
        where = f"scene {number}: {screenplay.scenes[number - 1].get('name', number)}" if number else "setting the scene"
        print(f"\nFailed during {where}\n{failure}", file=sys.stderr)
        try:
            game.shot(out / "failure.png")
            print(f"The game as the failure found it: {out / 'failure.png'}", file=sys.stderr)
        except Failure:
            pass
        set.clear()
        sys.exit("Filming failed")
    set.clear()

    raws = sorted(raw_dir.glob("*.avi"))
    if not raws:
        sys.exit(f"The game wrote no video into {raw_dir}")
    encode(raws[-1], mp4, marks if captions else [], wall, out / "captions.ass")
    shutil.rmtree(raw_dir)
    print(mp4)
    for still in stills:
        print(still)


def scout(screenplay, out, names):
    names = names or list(screenplay.stations)
    unknown = [name for name in names if name not in screenplay.stations]
    if unknown:
        sys.exit(f"No station {', '.join(unknown)}; the screenplay has {', '.join(screenplay.stations) or 'none'}")
    game = Game()
    set = Set(game, screenplay)
    camera = Camera(game, set)
    shots = []
    try:
        set.build()
        for name in names:
            camera.frame(name)
            shots.append(out / f"scout-{name}.png")
            game.shot(shots[-1])
    except (Failure, KeyboardInterrupt) as failure:
        print(failure, file=sys.stderr)
        set.clear()
        sys.exit("Scouting failed")
    set.clear()
    for still in shots:
        print(still)


def main():
    if len(sys.argv) < 2 or sys.argv[1] in ("help", "-h", "--help"):
        print(__doc__)
        return
    parser = argparse.ArgumentParser(prog="bin/film", add_help=False)
    parser.add_argument("words", nargs="+")
    parser.add_argument("--out")
    parser.add_argument("--no-captions", dest="captions", action="store_false")
    args = parser.parse_args()
    scouting = args.words[0] == "scout"
    words = args.words[1:] if scouting else args.words
    if not words:
        sys.exit("Name the screenplay; bin/film help")
    for tool in ("ffmpeg", "ffprobe"):
        if not shutil.which(tool):
            sys.exit(f"{tool} is not installed")
    try:
        screenplay = Screenplay(words[0])
    except Failure as failure:
        sys.exit(str(failure))
    out = pathlib.Path(args.out).expanduser().resolve() if args.out else videos_root() / project() / screenplay.slug
    out.mkdir(parents=True, exist_ok=True)
    if scouting:
        scout(screenplay, out, words[1:])
    else:
        film(screenplay, out, args.captions)


if __name__ == "__main__":
    main()
