#!/usr/bin/env bash
set -euo pipefail
source "$(dirname "$0")/lib/bench.sh"

world=${1:-take}
mods=${BENCH_MODS-roughseas agentbridge}
session=$BENCH-client
login_from=$HOME/.config/VintagestoryData/clientsettings.json
world_file=$root/bin/lib/world.json
seed=$(jq -r .seed "$world_file")
reference=$BENCH_REFERENCE/$seed.vcdbs
take=$BENCH_DATA/Saves/take.vcdbs

if [ "$world" = server ]; then
  target="--connect 127.0.0.1:$BENCH_SERVER_PORT"
elif [ "$world" = qa ]; then
  target="--connect 127.0.0.1:$QA_PORT"
elif [[ " $mods " == *" agentbridge "* && ! -f $BENCH_DATA/Saves/$world.vcdbs && $world != take ]]; then
  target="--openWorld $(printf %q "$world") --playStyle roughseas-test"
else
  target="--openWorld $(printf %q "$world")"
fi

mod_args=""
[[ " $mods " == *" roughseas "* ]] && mod_args="--addOrigin $root/RoughSeas/assets --addModPath $root/RoughSeas/bin/Debug/Mods"
if [[ " $mods " == *" agentbridge "* ]]; then
  [ -n "$mod_args" ] && mod_args="$mod_args $root/AgentBridge/bin/Debug/Mods" || mod_args="--addModPath $root/AgentBridge/bin/Debug/Mods"
fi

seed_settings() {
  local settings=$BENCH_DATA/clientsettings.json
  [ -f "$settings" ] && return
  [ -f "$login_from" ] || { echo "No game login at $login_from: log in once with the game's launcher, then run bin/client again." >&2; exit 1; }
  mkdir -p "$BENCH_DATA"
  jq '{
    stringSettings: (.stringSettings | with_entries(select(.key | IN("sessionkey", "sessionsignature", "useremail", "playername", "playeruid", "mptoken", "entitlements")))),
    intSettings: {gameWindowMode: 0, screenWidth: 1280, screenHeight: 800}
  }' "$login_from" > "$settings.seed"
  mv "$settings.seed" "$settings"
}

place_window() {
  [ -n "${BENCH_WORKSPACE:-}" ] && command -v hyprctl >/dev/null || return 0
  local previous
  previous=$(hyprctl activewindow -j | jq -r 'select(.class != "Vintage Story") | .address // empty')
  [ -z "${BENCH_MONITOR:-}" ] || hyprctl eval "hl.workspace_rule({ workspace = \"$BENCH_WORKSPACE\", monitor = \"$BENCH_MONITOR\" })" >/dev/null
  (
    for _ in $(seq 120); do
      sleep 0.5
      local pids address
      pids=$(pgrep -f -- "--dataPath $BENCH_DATA " | jq -s .)
      address=$(hyprctl clients -j | jq -r --argjson pids "$pids" 'first(.[] | select(.pid as $pid | $pids | index($pid)) | .address) // empty')
      [ -n "$address" ] || continue
      hyprctl eval "hl.dispatch(hl.dsp.window.move({ workspace = \"$BENCH_WORKSPACE\", follow = false, window = \"address:$address\" }))" >/dev/null
      [ -n "$previous" ] && hyprctl eval "hl.dispatch(hl.dsp.focus({ window = \"address:$previous\" }))" >/dev/null
      exit
    done
  ) &
}

leave_world() {
  local log=$BENCH_DATA/Logs/server-main.log after
  [[ $(pgrep -af -- "--dataPath $BENCH_DATA --tracelog") == *--openWorld* ]] || return 0
  after=$(log_lines "$log")
  "$root/bin/game" leave >/dev/null || { echo "The game did not answer to leave the world; stopping the client unsaved" >&2; return 1; }
  wait_for_log "$log" "$after" "Stopped the server!" 60 ||
    { echo "The world did not finish saving within a minute; stopping the client anyway" >&2; return 1; }
}

bench_settings() {
  local settings=$BENCH_DATA/clientsettings.json
  jq --argjson sound "${BENCH_SOUND:-0}" '.intSettings += {masterSoundLevel: $sound, soundLevel: 100, entitySoundLevel: 100, ambientSoundLevel: 100, weatherSoundLevel: 100, vsyncMode: 0, maxFps: 60}
    | .stringListSettings.disabledMods |= ((. // []) | map(select(test("^(roughseas|agentbridge)@") | not)))' "$settings" > "$settings.bench"
  mv -f "$settings.bench" "$settings"
}

launch() {
  local target=$1
  leave_world || true
  stop_session "$session" "$BENCH_DATA"
  bench_settings
  require_free_port "$BENCH_BRIDGE_PORT" "agent bridge"
  place_window
  # $target goes first: the embedded server re-parses these arguments, does not know --openWorld,
  # and would take the world name as one more value of a preceding --addOrigin or --addModPath.
  tmux new-session -d -s "$session" -c "$VINTAGE_STORY" \
    "$(game_env) ./run.sh $target --dataPath $BENCH_DATA --tracelog $mod_args"
  echo "Client starting in tmux session $session ($target; mods: ${mods:-none}); logs in $BENCH_DATA/Logs"
  if [[ " $mods " == *" agentbridge "* ]]; then
    "$root/bin/game" wait >/dev/null
    echo "World loaded and the server answers"
  fi
}

make_reference() {
  local server=$BENCH-reference data=$BENCH_TMP/reference zone config after
  local player audit=$BENCH_TMP/reference/Logs/server-audit.log
  [[ " $mods " == *" agentbridge "* && " $mods " == *" roughseas "* ]] ||
    { echo "Making the reference world needs both mods: run bin/client with the default BENCH_MODS" >&2; exit 1; }
  echo "This machine has no reference world for seed $seed; making it at $reference"
  rm -rf "$data"
  leave_world || true
  stop_session "$session" "$BENCH_DATA"
  trap "stop_session '$session' '$BENCH_DATA'; stop_server '$server' '$data'" EXIT
  config=$(jq -nc --arg seed "$seed" '{WorldConfig: {Seed: $seed, WorldName: "Rough Seas bench",
    PlayStyle: "roughseastest", PlayStyleLangCode: "roughseas-test", WorldType: "standard"}}')
  start_server "$server" "$data" "$config"
  launch "--connect 127.0.0.1:$BENCH_SERVER_PORT"
  player=$(jq -r .stringSettings.playername "$BENCH_DATA/clientsettings.json")
  after=$(log_lines "$audit")
  tmux send-keys -t "=$server:" "/op $player" Enter
  wait_for_log "$audit" "$after" "the role $player" 30 || { echo "The reference server never made $player an admin; read $audit" >&2; exit 1; }
  for zone in $(jq -r '.zones | keys[]' "$world_file") "$(jq -r .start "$world_file")"; do
    BENCH_SERVER_LOG=$data/Logs/server-debug.log "$root/bin/game" zone "$zone" >/dev/null
  done
  stop_session "$session" "$BENCH_DATA"
  stop_server "$server" "$data"
  trap - EXIT
  mkdir -p "$BENCH_REFERENCE"
  mv -f "$data/Saves/default.vcdbs" "$reference.$BENCH"
  mv -f "$reference.$BENCH" "$reference"
  rm -rf "$data"
}

cd "$root"
if [ "$world" = stop ]; then
  saved=0
  leave_world || saved=$?
  stop_session "$session" "$BENCH_DATA"
  rm -f "$take" "$take-wal" "$take-shm"
  echo "Client stopped, this job's copy of the reference world thrown away"
  exit "$saved"
fi

dotnet build RoughSeas -v quiet -nologo
dotnet build AgentBridge -v quiet -nologo
seed_settings

if [ "$world" = take ] && [ ! -f "$take" ]; then
  [ -f "$reference" ] || make_reference
  mkdir -p "$(dirname "$take")"
  cp -f "$reference" "$take"
fi
launch "$target"
