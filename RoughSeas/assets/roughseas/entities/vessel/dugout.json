            "wreckage": [{"type": "item", "code": "game:firewood", "quantity": {"avg": 8, "var": 4}}],
            "damage": {"textures": ["inside"], "material": "wood"},
            "sources": {
                "shell": "Walls about 5 cm thick, as the Dufuna canoe's (en.wikipedia.org/wiki/Dufuna_canoe). Carved from one log, a side stands from the bottom with its gunwale free, and a breaker bends it as a cantilever: by the model, 8.4 voxels from the bottom's edge to the gunwale",
                "depthMetres": "Keel to gunwale: a 0.21 m draft with one paddler and a hand's breadth or two of side above it, which a full bilge brings down to the water",
                "waterplaneSquareMetres": "A 4.5 m log, 0.75 m wide, with rounded ends: about two thirds of its box, so that 450 L aboard settles her by her 0.2 m of side"
            }
        },
        "roughseas:burnout": {
            "hollowings": 6,
            "hollowDepthMetres": 0.425,
            "rimMetres": 0.5,
            "charMillimetresPerHour": 2.5,
            "clay": "game:clay-*",
            "hewSaturation": 80,
            "sources": {
                "charMillimetresPerHour": "A burn of 3 to 5 hours chars 6 to 13 mm of wood (Agency House dugout diary, 2021-2023, agencyhouse.org/dugout-canoe)",
                "hollowings": "Wet clay goes along the rim before each day's fire (PHMC dugout project, 2005; SUNY Potsdam, 2015), and the fire is tended round the clock: a day chars about 6 cm, so the 0.42 m hollow takes six days, as Wampanoag builders burn a mishoon for 6 to 10 days (Plimoth Patuxet, The Making of a Mishoon)",
                "hollowDepthMetres": "Rim to floor of the hollow: the 0.5 m log less a 7.5 cm bottom, as thick as a mishoon's 4 to 6 inches between the hollow and the water allow (Plimoth Patuxet)",
                "clay": "A clay block digs into 4.5 clay; a band 10 cm wide and 3 cm thick along 10 m of rim and ends is 0.03 m³, under a seventh of one: one clay a day",
                "hewSaturation": "As hard as a patch of mending: scraping out a day's char by hand"
            }
        },
        "roughseas:launch": {
            "pushNewtons": 300,
            "strideMetres": 0.6,
            "friction": 0.4,
            "sources": {
                "pushNewtons": "A sustained two-handed push by an adult, about 300 N (Snook and Ciriello, 1991, maximum acceptable forces)",
                "strideMetres": "One step of the push",
                "friction": "Wood sliding over wet sand or mud, about 0.4"
            }
        },
        "passivephysicsmultibox": {
            "collisionBoxes": [
                {"x1": -0.375, "y1": 0, "z1": -2.0, "x2": 0.375, "y2": 0.56, "z2": -0.667},
